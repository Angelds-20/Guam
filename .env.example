# ==============================================================================
# NUAM EXCHANGE - VARIABLES DE ENTORNO
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=production

# Puerto HTTP de la aplicación
PORT=3000

# Ubicación de la Base de Datos Relacional SQLite (3FN)
SQLITE_FILE=src/data/nuam_tributario.sqlite

# URL base pública para CORS y despliegue
APP_URL=http://localhost:3000

# --- Autenticación (JWT) ------------------------------------------------------
# Secreto de firma de los tokens. En producción, reemplazar por un valor
# aleatorio de alta entropía (nunca commitear el secreto real).
JWT_SECRET=cambiar-este-secreto-en-produccion-nuam

# Duración del token de acceso (ej.: 8h, 1d, 60m, 3600s).
JWT_EXPIRES_IN=8h

# Nombre de la cookie httpOnly de sesión.
COOKIE_NAME=nuam_session

# Marca la cookie como Secure (true solo con HTTPS).
COOKIE_SECURE=false

# Política SameSite de la cookie: 'lax' | 'strict' | 'none'.
COOKIE_SAME_SITE=lax

# --- Protección ante fuerza bruta ---------------------------------------------
# Intentos fallidos permitidos por IP/correo dentro de la ventana.
RATE_LIMIT_MAX_ATTEMPTS=5

# Ventana de conteo en milisegundos (15 minutos = 900000).
RATE_LIMIT_WINDOW_MS=900000

# --- Datos canónicos (seed) ---------------------------------------------------
# Contraseña por defecto de los usuarios institucionales creados por el seed.
SEED_DEFAULT_PASSWORD=Nuam2026!
