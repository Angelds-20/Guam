# ==============================================================================
# NUAM EXCHANGE - VARIABLES DE ENTORNO (MODERN WEB DEV STANDARD)
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=production

# Puerto HTTP de la aplicación
PORT=3000

# Ubicación de la Base de Datos Relacional SQLite (3FN)
SQLITE_FILE=src/data/nuam_tributario.sqlite

# Ubicación de la Bitácora de Auditoría Semiestructurada (NoSQL JSON)
AUDIT_FILE=src/data/auditoria_eventos.json

# URL base pública para CORS y despliegue
APP_URL=http://localhost:3000
